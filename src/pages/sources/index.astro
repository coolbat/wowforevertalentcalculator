---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadManifest } from '@data/loadSnapshot';
import { EVIDENCE_DEFINITIONS, formatDate, stageLabel } from '@data/derive';
import {
  dataBuildLine,
  provenanceSentence,
  rankCoverageLine,
  shortDate,
} from '@data/credit';

const manifest = loadManifest();
const cov = manifest.coverage;
const stage = stageLabel(manifest.stage);
const published = formatDate(manifest.publishedAt);
const textPct = ((cov.ranksWithText / cov.ranksTotal) * 100).toFixed(1);
const buildLine = dataBuildLine(manifest);
const coverageLine = rankCoverageLine(cov.ranksWithText, cov.ranksTotal);
const missingRanks = cov.ranksTotal - cov.ranksWithText;
---

<BaseLayout
  title="Talent Data & Sources — WoW Forever Talent Calculator"
  description="Where this site's WoW Forever talent data comes from: source records, CC BY 4.0 attribution, coverage summary, evidence-status definitions, and the snapshot update policy."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Sources', url: '/sources/' },
  ]}
>
  <section class="page-head">
    <h1>Data &amp; Sources</h1>
    <p class="lede">
      Every number on this site traces back to a recorded source and a
      published snapshot. This page lists the sources, what the current
      snapshot covers, how each evidence status is defined, and how updates
      are handled.
    </p>
  </section>

  <section class="page-section" aria-labelledby="snapshot">
    <h2 id="snapshot">Current Snapshot</h2>
    <dl class="def-list">
      <dt>Snapshot ID</dt>
      <dd><code>{manifest.snapshotId}</code></dd>
      <dt>Stage</dt>
      <dd>{stage}</dd>
      <dt>Published</dt>
      <dd>{published}</dd>
      <dt>Upstream export</dt>
      <dd>{shortDate(manifest.sources[0]?.recordedAt ?? manifest.publishedAt)}</dd>
      <dt>Last checked</dt>
      <dd>{shortDate(manifest.checkedAt ?? manifest.publishedAt)}</dd>
      <dt>Ruleset</dt>
      <dd>
        <code>{manifest.rulesetId}</code> — levels {manifest.ruleset.minLevel}–
        {manifest.ruleset.maxLevel}, {manifest.ruleset.maxBudget} points at
        level {manifest.ruleset.maxLevel}, first point at level
        {' '}{manifest.ruleset.pointsStartLevel}
      </dd>
      <dt>Game build</dt>
      <dd>{manifest.gameBuild ?? 'Not recorded for this snapshot'}</dd>
      <dt>Schema version</dt>
      <dd>{manifest.schemaVersion}</dd>
      {
        manifest.sourceFileSha256 && (
          <>
            <dt>Source file SHA-256</dt>
            <dd>
              <code class="wrap-anywhere">{manifest.sourceFileSha256}</code>
            </dd>
          </>
        )
      }
    </dl>
    {buildLine && <p class="prose" data-testid="data-stamp">{buildLine}.</p>}
  </section>

  <section class="page-section" aria-labelledby="sources">
    <h2 id="sources">Source Records</h2>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Source</th>
            <th scope="col">Publisher</th>
            <th scope="col">Recorded</th>
            <th scope="col">License</th>
            <th scope="col">Review</th>
          </tr>
        </thead>
        <tbody>
          {
            manifest.sources.map((s) => (
              <tr>
                <td>
                  <a href={s.url} rel="external">
                    {s.url}
                  </a>
                </td>
                <td>{s.publisher}</td>
                <td>{formatDate(s.recordedAt)}</td>
                <td>{s.license ?? 'Not specified'}</td>
                <td>{s.reviewStatus}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="prose">
      Attribution: talent data from
      {' '}<a href="https://talentsforever.com/" rel="external">talentsforever.com</a>,
      used under the
      {' '}<a href="https://creativecommons.org/licenses/by/4.0/" rel="external">
        Creative Commons Attribution 4.0 International license (CC BY 4.0)
      </a>. Structure, prerequisites, and rank texts may be reformatted and
      annotated by this site; evidence statuses mark where that annotation is
      an estimate rather than a verified fact. Official game information:
      {' '}<a href="https://worldofwarcraft.blizzard.com/" rel="external">
        worldofwarcraft.blizzard.com
      </a>
      {' '}(EN) and the
      {' '}<a
        href="https://wow.blizzard.cn/forever/?channel=blizzard.gw.landing"
        rel="external"
      >
        魔兽世界中文官网“无限”站点
      </a>
      {' '}(CN).
    </p>
  </section>

  <section class="page-section" aria-labelledby="coverage">
    <h2 id="coverage">Coverage Summary</h2>
    <dl class="def-list">
      <dt>Structure review</dt>
      <dd>
        {
          cov.structureReviewed
            ? 'Completed — tree layouts, max ranks, prerequisites, and budgets reviewed for all 9 classes'
            : 'Not completed'
        }
      </dd>
      <dt>Talents</dt>
      <dd>{cov.talentCount}</dd>
      <dt>Rank text coverage</dt>
      <dd>
        {cov.ranksWithText} of {cov.ranksTotal} ranks have effect text ({
          textPct
        }%)
      </dd>
      <dt>Community recorded</dt>
      <dd>{cov.ranksCommunityRecorded} ranks</dd>
      <dt>Source estimate</dt>
      <dd>{cov.ranksSourceEstimate} ranks</dd>
      <dt>Unknown</dt>
      <dd>{cov.ranksUnknown} ranks (no effect text available)</dd>
      <dt>Prerequisites</dt>
      <dd>{cov.prerequisitesResolved} of {cov.prerequisitesTotal} resolved</dd>
    </dl>
    <p class="prose">
      <strong>
        Having text is not the same as being verified.
      </strong>{' '}
      {coverageLine}. {provenanceSentence()}
      {
        cov.ranksSourceEstimate > 0 || missingRanks > 0
          ? ` ${cov.ranksSourceEstimate} ranks are marked as source estimates and ${missingRanks} have no text.`
          : ''
      }
      {' '}Accuracy claims belong to the per-rank evidence status below, not to
      the coverage totals.
    </p>
  </section>

  <section class="page-section" aria-labelledby="evidence">
    <h2 id="evidence">Evidence Status Definitions</h2>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Status</th>
            <th scope="col">Meaning</th>
          </tr>
        </thead>
        <tbody>
          {
            EVIDENCE_DEFINITIONS.map((d) => (
              <tr>
                <td>
                  <span class={`badge badge-${d.status}`}>{d.label}</span>
                </td>
                <td>{d.definition}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="prose">
      Statuses are stored per rank, not per page or per class: an official
      announcement about one {stage.toLowerCase()} change does not upgrade the
      evidence status of every rank description on that talent.
    </p>
  </section>

  <section class="page-section prose" aria-labelledby="policy">
    <h2 id="policy">Snapshot &amp; Update Policy</h2>
    <p>
      Each import publishes one current snapshot. Class files use
      content-hashed names, and the manifest records the snapshot ID. The
      previous snapshot ID stays on the manifest so older share links can
      still be read.
    </p>
    <p>
      A share link records the snapshot it was created with. Links from the
      previous snapshot open on the current data: renamed talents keep their
      points under the current name, and points in talents that no longer
      exist are refunded. The rest of the build stays when it is still legal
      under the current rules.
    </p>
  </section>
</BaseLayout>
