---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadManifest } from '@data/loadSnapshot';
import { formatDate } from '@data/derive';
import { rankCoverageLine } from '@data/credit';
import {
  classHasChanges,
  describeCell,
  describeMove,
  describeRequires,
  entryTotals,
  loadChangelogEntries,
} from '@data/changelog';

const manifest = loadManifest();
const entries = loadChangelogEntries();
const latest = entries[0];
const description = latest
  ? `Every data update to the WoW Forever talent calculator. Now on beta build ${manifest.gameBuild} (upstream export ${formatDate(latest.upstreamExport ?? latest.date)}), with all talent changes listed by class.`
  : 'Every data update to the WoW Forever talent calculator, with all talent changes listed by class.';
---

<BaseLayout
  title="WoW Forever Talent Calculator Changelog & Data Updates"
  description={description}
  dateModified={latest?.date ?? manifest.publishedAt}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Changelog', url: '/changelog/' },
  ]}
>
  <section class="page-head">
    <h1>Changelog</h1>
    <p class="lede">
      We update the calculator when a new WoW Forever beta build changes
      talents. Talent data comes from
      <a href="https://talentsforever.com/" rel="external">talentsforever.com</a>
      (CC BY 4.0), a community export of the beta game files. Each entry
      lists what that export now records compared with our previous
      snapshot; it is the source's current record, not a value confirmed in
      the game.
    </p>
  </section>

  {
    entries.map((entry) => {
      const totals = entryTotals(entry);
      const changedClasses = Object.values(entry.classes).filter(classHasChanges);
      const unchangedClasses = Object.values(entry.classes)
        .filter((c) => !classHasChanges(c))
        .map((c) => c.className);
      return (
        <section class="page-section prose" aria-labelledby={`entry-${entry.id}`}>
          <h2 id={`entry-${entry.id}`}>
            {formatDate(entry.date)} — Beta build {entry.build}
          </h2>
          <p>
            The calculator now uses beta build {entry.build} as recorded in the
            Talents Forever export of {formatDate(entry.upstreamExport ?? entry.date)},
            checked on {formatDate(entry.date)}. The previous snapshot was build{' '}
            {entry.previousBuild} (export {formatDate(entry.previousUpstreamExport ?? entry.date)}).{' '}
            {entry.ranksWithText !== null && entry.ranksTotal !== null
              ? `${rankCoverageLine(entry.ranksWithText, entry.ranksTotal)}.`
              : ''}{' '}
            Saved builds and share links still open: points on renamed
            talents are kept under the new name, and points on talents that are
            no longer in the data are refunded.
          </p>
          <p>
            In total: {totals.added} talents added, {totals.removed} removed,{' '}
            {totals.renamed} renamed, {totals.moved} moved, {totals.rankCount}{' '}
            with a different rank count, {totals.prerequisites} with different
            prerequisites, and {totals.text} with updated effect text.
          </p>
          <ul>
            {changedClasses.map((c) => (
              <li>
                <strong>{c.className}:</strong>
                {c.added.length > 0 && (
                  <>
                    {' '}Added {c.added.map((a) => `${a.name} (${describeCell(a)})`).join(', ')}.
                  </>
                )}
                {c.removed.length > 0 && (
                  <>
                    {' '}No longer in the export:{' '}
                    {c.removed.map((r) => `${r.name} (was ${describeCell(r)})`).join(', ')}.
                  </>
                )}
                {c.renamed.length > 0 && (
                  <>
                    {' '}Renamed:{' '}
                    {c.renamed.map((r) => `${r.from} is now ${r.to}`).join('; ')}.
                  </>
                )}
                {c.moved.length > 0 && (
                  <>
                    {' '}Moved:{' '}
                    {c.moved.map((m) => `${m.name} (${describeMove(m.from, m.to)})`).join(', ')}.
                  </>
                )}
                {c.maxRankChanged.length > 0 && (
                  <>
                    {' '}Rank count changed:{' '}
                    {c.maxRankChanged.map((m) => `${m.name} ${m.from} → ${m.to}`).join(', ')}.
                  </>
                )}
                {c.prerequisitesChanged.length > 0 && (
                  <>
                    {' '}Prerequisites changed:{' '}
                    {c.prerequisitesChanged
                      .map(
                        (p) =>
                          `${p.name} now requires ${describeRequires(p.to)} (was ${describeRequires(p.from)})`,
                      )
                      .join('; ')}.
                  </>
                )}
                {c.textChanged.length > 0 && (
                  <>
                    {' '}Effect text updated:{' '}
                    {c.textChanged.map((t) => t.name).join(', ')}.
                  </>
                )}
                {c.textChanged.length > 0 && (
                  <details class="changelog-details">
                    <summary>
                      {c.className}: what the effect text said before and now
                    </summary>
                    <ul>
                      {c.textChanged.map((t) => {
                        const first = t.ranks[0];
                        return (
                          <li>
                            <strong>{t.name}</strong> (rank{' '}
                            {t.ranks.map((r) => r.rank).join(', ')} changed; rank{' '}
                            {first.rank} shown)
                            <br />
                            Was: {first.before ?? 'no text'}
                            <br />
                            Now: {first.after ?? 'no text'}
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                )}
              </li>
            ))}
            {unchangedClasses.length > 0 && (
              <li>
                <strong>{unchangedClasses.join(', ')}:</strong> no differences
                from the previous snapshot.
              </li>
            )}
          </ul>
        </section>
      );
    })
  }

  <section class="page-section prose" aria-labelledby="build-70291">
    <h2 id="build-70291">October 15, 2026 — Beta build 70291</h2>
    <p>
      The calculator now uses beta build 70291 (October 8, 2026), including
      the Warrior hotfixes of October 1–2. Saved builds and share links still
      open. Points on removed talents are refunded.
    </p>
    <ul>
      <li>
        <strong>Warrior:</strong> Fury gains Lingering Rage, Furious Precision
        and Gore Drinker. Improved Cleave, Boundless Rage and Precision are
        removed. Protection loses Toughness and Vitality; Iron Will moves to
        row 1. Focused Rage moves from row 6 to row 5; Bastion stays in row
        6. Impale now requires Deep Wounds.
      </li>
      <li>
        <strong>Druid:</strong> Mangle is now Primal Bite and Primal Fury is
        Blood Frenzy. Feral loses King of the Jungle and gains Shifting Power
        and Improved Shifting Power. Predatory Instincts is now Natural
        Instinct.
      </li>
      <li><strong>Druid:</strong> Balance of Nature is removed.</li>
      <li>
        <strong>Paladin:</strong> Improved Holy Strike and Crusade are
        removed. Holy Strike has a 10-second cooldown. Holy Shield now
        increases chance to block by 30% (was 20%).
      </li>
      <li><strong>Rogue:</strong> Restless Blades is removed.</li>
      <li>
        <strong>Priest:</strong> Penance rank 4 deals 92 damage (was 131) and
        heals 425 (was 673).
      </li>
      <li>
        <strong>Mage:</strong> Hot Streak is now Heating Up.
      </li>
      <li>
        <strong>Warlock:</strong> Soul Harvesting is now Soul Harvest.
      </li>
      <li><strong>Warlock:</strong> Drain Hope is removed.</li>
      <li>
        <strong>Shaman:</strong> Elemental Alacrity moves from row 6 to row 3
        and no longer has a prerequisite. Elemental Fury moves to row 6.
        Water Shield has no cooldown.
      </li>
      <li>
        <strong>Hunter:</strong> Lightning Reflexes is 2% per rank.
        Resourcefulness is 30%/60%. Deflection is 1% per rank. Expose Prey
        lasts 10 seconds. Sniper Shot reaches 45 yards.
      </li>
    </ul>
  </section>

  <section class="page-section prose" aria-labelledby="launch">
    <h2 id="launch">September 17, 2026 — Launch</h2>
    <p>
      First release with all classes, based on BlizzCon 2026 data (September
      15, 2026).
    </p>
  </section>

  <section class="page-section prose" aria-label="Related pages">
    <p>
      <a href="/">Calculator →</a> ·
      <a href="/wow-forever-beta-end/">Beta end &amp; launch dates →</a>
    </p>
  </section>
</BaseLayout>
